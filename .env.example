VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ask chatbot: calls the "ask-proxy" Supabase Edge Function, which needs its own
# N8N_ASK_WEBHOOK_URL / N8N_ASK_WEBHOOK_SECRET set via `supabase secrets set` —
# see README for setup. No client-side env vars needed for it.

# Push notifications: generate a key pair with `npx web-push generate-vapid-keys`,
# put the public key here, and set VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
# (VAPID_SUBJECT is a mailto: or https: URL identifying you to push services) as
# Supabase Edge Function secrets via `supabase secrets set` — see README.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
